root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,js,jsx,json,yml,yaml,css,scss,less,html}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
max_line_length = 100

[*.cs]
indent_size = 4

[*.xaml]
indent_size = 4

[*.sql]
indent_size = 4

[*.py]
indent_size = 4
