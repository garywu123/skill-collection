{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Skills: Deploy",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/deploy-skill/Deploy-Skills.ps1",
        "-SkillConfigPath",
        "${workspaceFolder}/scripts/deploy-skill/deploy-skills.json"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Doc Sync: Sync docs to Obsidian",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "D:\\code\\lib-projects\\dev-tools\\doc-sync\\Sync-DocWorkspace.ps1",
        "-ConfigPath",
        "${workspaceFolder}\\doc-sync.config.json",
        "-RepoRoot",
        "${workspaceFolder}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Doc Sync: Preview (WhatIf)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "D:\\code\\lib-projects\\dev-tools\\doc-sync\\Sync-DocWorkspace.ps1",
        "-ConfigPath",
        "${workspaceFolder}\\doc-sync.config.json",
        "-RepoRoot",
        "${workspaceFolder}",
        "-WhatIf"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
